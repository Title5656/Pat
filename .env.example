DISCORD_TOKEN=
VOICE_LOG_CHANNEL_ID=
PAT_CHAT_CHANNEL_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Pim branch: personal roles rotate daily at midnight Asia/Bangkok.
# Enable Server Members Intent in Discord Developer Portal and grant Manage Roles.
PIM_ROLES_ENABLED=true
# Optional: defaults to the server containing VOICE_LOG_CHANNEL_ID.
PIM_ROLE_GUILD_ID=
# Store ownership separately so role names contain only friends' names.
# On Render, put this on a persistent disk (e.g. /var/data/pim-roles.sqlite).
PIM_ROLE_DATABASE_PATH=data/pim-roles.sqlite

# Optional shared stopwatch room on the SAME Pat bot. Leave channel blank to disable.
PAT_STOPWATCH_CHANNEL_ID=

# Pim music uses the same stopwatch channel for /play, /queue, /skip, /stop.
# Grant View Channel, Connect, Speak in voice rooms and Send Messages in this room.
# Include applications.commands when inviting the bot.
PIM_MUSIC_ENABLED=true
# Optional host-installed tools; defaults are installed by npm ci.
PIM_YTDLP_PATH=
PIM_FFMPEG_PATH=
# Optional Netscape cookies file. Render automatically uses its Secret File named youtube-cookies.txt.
# Cookie contents belong in Render Secret Files, never here or in Git.
PIM_YOUTUBE_COOKIES_FILE=

# Optional research room on the SAME Pat bot. Leave channel blank to disable.
PAT_RESEARCH_CHANNEL_ID=
# Reuses DISCORD_TOKEN, GEMINI_API_KEY and GEMINI_MODEL above.
# Optional: point this to your persistent disk in production.
PAT_RESEARCH_DATABASE_PATH=data/research.sqlite
PAT_RESEARCH_SYNC_INTERVAL_SECONDS=60
PAT_RESEARCH_PAGES_PER_CHANNEL=3
PAT_RESEARCH_CONTEXT_BEFORE=2
PAT_RESEARCH_CONTEXT_AFTER=2
