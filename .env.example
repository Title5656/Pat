DISCORD_TOKEN=
VOICE_LOG_CHANNEL_ID=
PAT_CHAT_CHANNEL_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional research room on the SAME Pat bot. Leave channel blank to disable.
PAT_RESEARCH_CHANNEL_ID=
# Reuses DISCORD_TOKEN, GEMINI_API_KEY and GEMINI_MODEL above.
# Optional: point this to your persistent disk in production.
PAT_RESEARCH_DATABASE_PATH=data/research.sqlite
PAT_RESEARCH_SYNC_INTERVAL_SECONDS=60
PAT_RESEARCH_PAGES_PER_CHANNEL=3
