# Create a NEW Discord application/bot. These values are never read from Pat.
RESEARCH_DISCORD_TOKEN=
RESEARCH_APPLICATION_ID=
RESEARCH_QA_CHANNEL_ID=
# Trusted Discord user IDs, comma-separated. Keep the Q&A channel private to them.
RESEARCH_ALLOWED_USER_IDS=
RESEARCH_GEMINI_API_KEY=
RESEARCH_GEMINI_MODEL=gemini-flash-latest
# Relative paths resolve inside this project. Use a persistent disk in production.
RESEARCH_DATABASE_PATH=data/messages.sqlite
RESEARCH_SYNC_INTERVAL_SECONDS=60
RESEARCH_PAGES_PER_CHANNEL=3
# Optional health server for deployment platforms.
# PORT=3000
